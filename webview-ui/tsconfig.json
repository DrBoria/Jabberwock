{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"types": ["vitest/globals"],
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		"module": "esnext",
		"sourceMap": true,
		"inlineSources": false,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"allowArbitraryExtensions": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@src/*": ["./src/*"],
			"@shared/*": ["../src/shared/*"],
			"@jabberwock/types": ["../../packages/types/src/index.ts"],
			"@jabberwock/devtool/webview": ["../../packages/devtool/src/webview-entry.ts"],
			"@eventConstants": ["../../packages/types/src/event-constants"],
			"@intentConstants": ["./src/features/intents/IntentConstants"],
			"@packageJson": ["../src/package.json"],
			"@utils/*": ["../src/utils/*"],
			"@api/*": ["../src/api/*"],
			"@components/*": ["./src/components/*"],
			"@sections/*": ["./src/sections/*"],
			"@i18n": ["../src/i18n"],
			"@i18n/*": ["../src/i18n/*"],
			"@features/*": ["../src/features/*"],
			"@services/*": ["../src/services/*"]
		}
	},
	"include": ["src", "../src/types", "../src/package.json", "vitest.setup.ts"],
	"exclude": ["node_modules"]
}
