{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "build/**"]
		},
		"build:nightly": {
			"outputs": ["apps/vscode-nightly/build/**"]
		},
		"bundle": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"vsix": {
			"dependsOn": ["bundle"],
			"inputs": ["dist/**"],
			"outputs": ["bin/**"]
		},
		"watch:bundle": {
			"dependsOn": ["@jabberwock/build#build", "@jabberwock/types#build"],
			"cache": false,
			"persistent": true
		},
		"watch:tsc": {
			"dependsOn": ["@jabberwock/build#build", "@jabberwock/types#build"],
			"cache": false,
			"persistent": true
		},
		"check-types": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"lint": {
			"cache": false
		},
		"test": {},
		"format": {
			"cache": false
		}
	}
}
