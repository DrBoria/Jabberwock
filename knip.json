{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"ignore": [
		"**/__tests__/**",
		"**/dist/**",
		"**/build/**",
		"backend/workers/countTokens.ts",
		"apps/cli/scripts/**",
		"apps/web-roo-code/next-sitemap.config.cjs",
		"DebugMCP/**",
		"loseless-context/**",
		"md-todo-mcp/**",
		"reports/**"
	],
	"ignoreWorkspaces": ["DebugMCP", "loseless-context", "md-todo-mcp"],
	"workspaces": {
		".": {
			"entry": ["scripts/*.mjs", "tests/*.ts"],
			"project": ["scripts/**/*.mjs", "tests/**/*.ts"]
		},
		"backend": {
			"entry": ["index.ts", "**/index.ts"],
			"project": ["**/*.ts"]
		},
		"frontend": {
			"entry": ["src/index.tsx", "src/**/index.ts", "src/**/index.tsx"],
			"project": ["src/**/*.{ts,tsx}"]
		},
		"connectors/*": {
			"entry": ["backend/main.ts", "frontend/connector.ts"],
			"project": ["**/*.ts"]
		},
		"apps/cli": {
			"entry": ["src/index.ts", "src/cli.ts"],
			"project": ["src/**/*.ts"]
		},
		"apps/web-evals": {
			"entry": ["src/app/**/*.{ts,tsx}", "next.config.ts"],
			"project": ["src/**/*.{ts,tsx}"]
		},
		"apps/web-jabberwock": {
			"entry": ["src/app/**/*.{ts,tsx}", "next.config.ts", "next-sitemap.config.cjs"],
			"project": ["src/**/*.{ts,tsx}"]
		},
		"packages/{build,cloud,core,devtool,evals,ipc,telemetry,types,vscode-shim,ws-protocol}": {
			"entry": ["src/index.ts", "src/**/index.ts"],
			"project": ["src/**/*.ts"]
		}
	}
}
