{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"ignore": [
		"**/__tests__/**",
		"apps/vscode-e2e/**",
		"backend/extension/api.ts",
		"connectors/vscode/backend/activation/**",
		"backend/workers/countTokens.ts",
		"backend/extension.ts",
		"scripts/**",
		"apps/cli/scripts/**",
		"apps/web-roo-code/next-sitemap.config.cjs"
	],
	"workspaces": {
		"backend": {
			"entry": ["extension.ts"],
			"project": ["**/*.ts"]
		},
		"frontend": {
			"entry": ["src/index.tsx"],
			"project": ["src/**/*.{ts,tsx}", "../backend/shared/*.ts"]
		},
		"connectors/*": {
			"entry": ["backend/main.ts"],
			"project": ["**/*.ts"]
		},
		"packages/{build,cloud,evals,ipc,telemetry,types}": {
			"project": ["src/**/*.ts"]
		}
	}
}
