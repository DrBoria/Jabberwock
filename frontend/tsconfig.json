{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"types": ["vitest/globals"],
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		"module": "esnext",
		"sourceMap": true,
		"inlineSources": false,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"allowArbitraryExtensions": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@src/*": ["./src/*"],
			"@shared/*": ["../backend/shared/*"],
			"@jabberwock/types": ["../../packages/types/src/index.ts"],
			"@jabberwock/devtool/webview": ["../../packages/devtool/src/webview-entry.ts"],
			"@eventConstants": ["../../packages/types/src/event-constants"],
			"@intentConstants": ["./src/features/intents/IntentConstants"],
			"@packageJson": ["../backend/package.json"],
			"@utils/*": ["../backend/utils/*"],
			"@api": ["../backend/api/index.ts"],
			"@api/*": ["../backend/api/*"],
			"@components/*": ["./src/components/*"],
			"@sections/*": ["./src/sections/*"],
			"@i18n": ["../backend/i18n"],
			"@i18n/*": ["../backend/i18n/*"],
			"@features/*": ["../backend/features/*"],
			"@foundation/*": ["../backend/foundation/*"],
			"@services/*": ["../backend/services/*"],
			"@activate/*": ["../connectors/vscode/backend/activation/*"],
			"@integrations/*": ["../backend/integrations/*"],
			"@workers/types": ["../backend/workers/types.ts"],
			"@packages/types/src/mcp": ["../packages/types/src/mcp/mcp.ts"],
			"@connectors/*": ["../connectors/*"]
		}
	},
	"include": ["src", "../backend/types", "../backend/package.json", "vitest.setup.ts"],
	"exclude": ["node_modules"]
}
