// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		// ─── Backend (Extension Host) ───────────────────────────────────────
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/src",
				"--disable-extension",
				"ozzafar.debugmcpextension"
			],
			"sourceMaps": true,
			"outFiles": ["${workspaceFolder}/src/dist/**/*.js", "${workspaceFolder}/packages/*/dist/**/*.js"],
			"preLaunchTask": "${defaultBuildTask}",
			"env": {
				"NODE_ENV": "development",
				"VSCODE_DEBUG_MODE": "true"
			},
			"resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
			"presentation": {
				"group": "backend",
				"order": 1
			}
		},
		{
			"name": "Attach to Extension Host",
			"type": "extensionHost",
			"request": "attach",
			"port": 9229,
			"sourceMaps": true,
			"outFiles": ["${workspaceFolder}/src/dist/**/*.js", "${workspaceFolder}/packages/*/dist/**/*.js"],
			"resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
			"presentation": {
				"group": "backend",
				"order": 2
			}
		},

		// ─── Webview UI (Chrome DevTools) ──────────────────────────────────
		{
			"name": "Debug Webview",
			"type": "chrome",
			"request": "attach",
			"port": 5173,
			"url": "http://localhost:5173",
			"webRoot": "${workspaceFolder}/webview-ui/src",
			"sourceMaps": true,
			"trace": true,
			"presentation": {
				"group": "webview",
				"order": 1
			}
		}
	],
	"compounds": [
		{
			"name": "Debug All",
			"configurations": ["Run Extension", "Debug Webview"],
			"preLaunchTask": "${defaultBuildTask}",
			"stopAll": true
		}
	]
}
