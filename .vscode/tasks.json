{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "watch",
			"dependsOn": ["build:webview", "build:extension", "watch:bundle", "watch:tsc"],
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "build:webview",
			"type": "shell",
			"command": "pnpm --filter @jabberwock/frontend build",
			"group": "build",
			"presentation": {
				"reveal": "always"
			}
		},
		{
			"label": "build:extension",
			"type": "shell",
			"command": "pnpm --filter jabberwock bundle",
			"group": "build",
			"presentation": {
				"reveal": "always"
			}
		},
		{
			"label": "watch:webview",
			"type": "shell",
			"command": "cd frontend && pnpm dev",
			"isBackground": true,
			"problemMatcher": {
				"owner": "webview",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*VITE.*v.*",
					"endsPattern": "ready in"
				}
			},
			"presentation": {
				"group": "watch",
				"reveal": "always"
			}
		},
		{
			"label": "watch:bundle",
			"type": "shell",
			"command": "pnpm --filter jabberwock watch:bundle",
			"group": "build",
			"problemMatcher": {
				"owner": "esbuild",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "esbuild-problem-matcher#onStart",
					"endsPattern": "esbuild-problem-matcher#onEnd"
				}
			},
			"isBackground": true,
			"presentation": {
				"group": "watch",
				"reveal": "always"
			}
		},
		{
			"label": "watch:tsc",
			"type": "shell",
			"command": "pnpm --filter jabberwock watch:tsc",
			"isBackground": true,
			"problemMatcher": {
				"owner": "typescript",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": ".*"
				}
			},
			"presentation": {
				"group": "watch",
				"reveal": "always"
			}
		}
	]
}
