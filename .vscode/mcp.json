{
	"servers": {
		"jabberwock-devtools": {
			"type": "stdio",
			"command": "node",
			"args": [
				"--experimental-websocket",
				"--import",
				"tsx",
				"packages/vscode-extension-devtool-mcp/src/mcp/transport/stdio.ts"
			]
		},
		"serena": {
			"type": "stdio",
			"command": "serena",
			"args": ["start-mcp-server", "--project", "."]
		},
		"rpg": {
			"type": "stdio",
			"command": "npx",
			"args": ["-y", "-p", "rpg-encoder", "rpg-mcp-server"]
		}
	}
}
